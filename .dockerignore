# Ignore .NET build output
bin/
obj/
out/
[Bb]uild/
[Ll]ogs/

# User-specific files
*.user
*.suo
*.rsuser
*.swp
*.vspscc

# IDE and editor settings
.vs/
.vscode/
.idea/

# Node.js (if you have a React/Angular frontend)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
pnpm-lock.yaml

# Environment & secrets
*.env
*.env.*
secrets.json
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.local.json
!**/appsettings.json

# Temporary files
*.tmp
*.log
*.bak
*.cache
*.pdb

# Docker-specific files to avoid nested builds
Dockerfile.*
docker-compose*.yml
.docker/

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Publish artifacts (if you're building via dotnet publish)
**/publish/
**/dist/
**/artifacts/

# Azure or deployment settings
*.pubxml
*.publishproj
*.azurePubxml

# Test output
TestResults/
*.trx
*.coverage
*.coveragexml

# Git files
.git/
.gitignore
.gitattributes

# Local tools
tools/